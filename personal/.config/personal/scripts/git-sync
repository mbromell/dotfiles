#!/usr/bin/env bash

set -euo pipefail

# Fetch first to ensure we have the most up-to-date remote branches
git fetch

if [[ "$#" -ge 1 ]]; then
  TARGET_BRANCH=$1
  # Strip 'origin/' if accidentally provided in the argument
  TARGET_BRANCH=${TARGET_BRANCH#origin/}
else
  echo "No branch provided. Detecting latest release branch..."

  # Search remote branches, sort descending by version, and grab the top one
  LATEST_REF=$(git for-each-ref --sort=-v:refname --format='%(refname:short)' 'refs/remotes/origin/release/*.x' | head -n 1)

  if [[ -z "$LATEST_REF" ]]; then
    echo "Error: No release branches found matching 'origin/release/*.x'."
    exit 1
  fi

  # Extract just the branch name by stripping 'origin/'
  TARGET_BRANCH=${LATEST_REF#origin/}

  echo "Targeting latest release branch: ${TARGET_BRANCH}"
fi

RELEASE_REF="origin/${TARGET_BRANCH}"
MAIN_SHA=$(git rev-parse --short origin/main)

# Replace forward slashes with dashes for the working branch name
# (e.g., 'release/1.12.x' becomes 'release-1.12.x')
SAFE_BRANCH_SUFFIX=${TARGET_BRANCH//\//-}
BRANCH_NAME="hotfix/CURE-0/sync-${SAFE_BRANCH_SUFFIX}-${MAIN_SHA}"

git checkout --no-track -b "${BRANCH_NAME}" "${RELEASE_REF}"
git merge origin/main

gh pr create \
  --title "chore: sync main at ${MAIN_SHA}" \
  --body "Syncing with main at commit: ${MAIN_SHA}" \
  --base "${TARGET_BRANCH}" \
  --web
